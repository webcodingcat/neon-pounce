{
  "name": "neon-pounce",
  "version": "0.0.0",
  "private": true,
  "description": "A fast neon sorting puzzle for phones",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "pixi.js": "8.23.0"
  }
}
